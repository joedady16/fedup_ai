# ---------- Core ----------

POSTGRES_USER=fedup
POSTGRES_PASSWORD=change-me-in-dot-env
POSTGRES_DB=fedup
DATABASE_URL=postgres://fedup:change-me-in-dot-env@db:5432/fedup

# Secret for signing login cookies. Generate: openssl rand -base64 48
AUTH_SECRET=

# ---------- First admin (created on first boot) ----------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-too

# ---------- Local models (Ollama on the WSL host) ----------
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=gemma3:latest
OLLAMA_VISION_MODEL=llava:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------- Smart mode (optional, costs money) ----------
# Get a key at console.anthropic.com. Smart mode uses Claude Opus 5.
# Leave blank to keep everything 100% local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Live web search + page fetching, via Claude's server-side tools.
# Smart mode only (the local model has no search backend), and never
# enabled for child accounts. Set to false to turn it off entirely.
WEB_ACCESS=true

# ---------- Images ----------
# 'comfy' = local ComfyUI container, 'none' = disable image generation
IMAGE_PROVIDER=comfy
# On an 8GB card the chat and image models cannot both stay resident.
# Leave true: Ollama is evicted before a render and reloads afterwards.
FREE_VRAM_FOR_IMAGES=true
COMFYUI_URL=http://comfyui:8188
COMFYUI_MODEL=sd_xl_turbo_1.0_fp16.safetensors

# ---------- Host ports (3000/5432/5433 were already in use) ----------
APP_URL=http://localhost:3080

# ---------- Home network access ----------
# The login cookie is normally marked Secure, which browsers only accept
# over HTTPS. Set this to 1 so phones and tablets can sign in over plain
# http:// on your LAN. Fine for a home server; do not expose to the
# internet with this on.
ALLOW_HTTP=1
